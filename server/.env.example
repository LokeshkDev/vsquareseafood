# ─── Server Configuration ───
NODE_ENV=development
PORT=5000

# ─── AWS Lightsail MySQL Database ───
#
# Option A: AWS Lightsail Managed Database (RDS-backed)
# DATABASE_URL="mysql://dbmasteruser:YourPassword123@ls-abc123xyz.czxxxxxxxx.ap-south-1.rds.amazonaws.com:3306/vsquare_seafood?connect_timeout=30&pool_timeout=30&sslmode=prefer"
#
# Option B: AWS Lightsail Linux Instance (Self-Hosted MySQL on VPS)
# DATABASE_URL="mysql://dbuser:YourPassword123@13.234.xxx.xxx:3306/vsquare_seafood?connect_timeout=30&pool_timeout=30"
#
DATABASE_URL="mysql://user:password@localhost:3306/vsquare_seafood"

LIGHTSAIL_DB_HOST=
LIGHTSAIL_DB_PORT=3306
LIGHTSAIL_DB_USER=
LIGHTSAIL_DB_PASSWORD=
LIGHTSAIL_DB_NAME=

# ─── JWT Authentication ───
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# ─── Client URL (for CORS) ───
CLIENT_URL=http://localhost:3000

# ─── Cloudflare R2 Object Storage ───
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vsquare-seafood
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# ─── Razorpay Payment Gateway ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Email / SMTP Notifications ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
